{
  "version": 3,
  "title": "Warhammer Survivors (Demo) – Preset",
  "process": "WarhammerSurvivors.exe",
  "speed": {},
  "entries": [
    {"desc": "Münzen", "expr": "unity:VampireSurvivors.Framework.GM::Core._playerOptions._currentSiloSaveData.Coins",
     "type": "Float", "group": "Spielstand", "hotkey": "F5", "hk_action": "add", "hk_value": 1000},
    {"desc": "Leben", "expr": "unity:VampireSurvivors.Framework.GM::Core._mainCharacters[0]._currentHp",
     "type": "Float", "group": "Spieler", "hotkey": "F1", "hk_action": "toggle"},
    {"desc": "Unverwundbar (1 = an)", "expr": "unity:VampireSurvivors.Framework.GM::Core._mainCharacters[0]._isInvul",
     "type": "Byte", "group": "Spieler", "value": 1, "hotkey": "F2", "hk_action": "toggle"},
    {"desc": "Level", "expr": "unity:VampireSurvivors.Framework.GM::Core._mainCharacters[0]._level",
     "type": "4 Bytes", "group": "Spieler"},
    {"desc": "XP (+500 per Hotkey)", "expr": "unity:VampireSurvivors.Framework.GM::Core._mainCharacters[0]._xp",
     "type": "Float", "group": "Spieler", "hotkey": "F3", "hk_action": "add", "hk_value": 500},
    {"desc": "Laufgeschwindigkeit (Faktor)", "expr": "unity:VampireSurvivors.Framework.GM::Core._mainCharacters[0].MoveSpeedMultiplier",
     "type": "Float", "group": "Spieler"}
  ],
  "actions": [
    {"desc": "Kill-all (Rosenkranz)", "call": "VampireSurvivors.Framework.GM::Core.RosaryDamage(true, 1.8)",
     "hotkey": "F9", "interval": 10},
    {"desc": "Kill-all leise (für Timer)", "call": "VampireSurvivors.Framework.GM::Core.RosaryDamage(false, 0)",
     "hotkey": "", "interval": 3},
    {"desc": "Spielstand speichern (mit Backup)", "call": "VampireSurvivors.Framework.GM::Core._playerOptions.Save(true, true)",
     "hotkey": "", "interval": 0},
    {"desc": "Alles freischalten (dauerhaft!)",
     "call": "VampireSurvivors.Framework.GM::Core._playerOptions.UnlockCharacter(keys:Core._playerOptions._dataManager._characterData); VampireSurvivors.Framework.GM::Core._playerOptions.UnlockWeapon(keys:Core._playerOptions._dataManager._weaponData); VampireSurvivors.Framework.GM::Core._playerOptions.UnlockStage(keys:Core._playerOptions._dataManager._stageData); VampireSurvivors.Framework.GM::Core._playerOptions.UnlockPowerUp(keys:Core._playerOptions._dataManager._powerUpData); VampireSurvivors.Framework.GM::Core._playerOptions.Save(true, true)",
     "hotkey": "", "interval": 0}
  ]
}
