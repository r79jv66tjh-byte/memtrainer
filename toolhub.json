        },
        {
          "name": "inherited",
          "flag": "--inherited",
          "type": "boolean",
          "required": false,
          "description": "Auch geerbte Methoden"
        }
      ],
      "readonly": true
    },
    {
      "name": "unity-call",
      "description": "Unity (IL2CPP): Spiel-Methode im Hauptthread aufrufen, z. B. 'GameManager::RosaryDamage(true, 1.8)' (Kill-all in Warhammer Survivors). Mehrere mit ';'. Objekt per Pfad: 'GameManager::_playerOptions.Save(true, true)'. Enum '*' = alle Werte, 'keys:feld.dict' = Schlüssel eines Dictionary. Kann den Spielstand dauerhaft ändern.",
      "run": [
        "python",
        "cli.py",
        "unity-call"
      ],
      "args": [
        {
          "name": "process",
          "flag": "--process",
          "type": "string",
          "required": true,
          "description": "exe-Name oder PID des Spiels"
        },
        {
