          "flag": "--call",
          "type": "string",
          "required": true,
          "description": "Aufruf Klasse::Methode(args)"
        },
        {
          "name": "dry_run",
          "flag": "--dry-run",
          "type": "boolean",
          "required": false,
          "description": "Nur beschreiben, nicht aufrufen"
        }
      ],
      "readonly": false
    }
  ]
}
